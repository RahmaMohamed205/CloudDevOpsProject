# Copy this file to terraform.tfvars and adjust the values for your own account.
# terraform.tfvars itself is git-ignored so that account-specific values are
# never committed.

project_name       = "ivolve"
environment        = "dev"
aws_region         = "us-east-1"
jenkins_key_name   = "ivolve-jenkins-key"
allowed_ssh_cidr   = "0.0.0.0/0" # restrict to your own IP, e.g. "203.0.113.10/32"
